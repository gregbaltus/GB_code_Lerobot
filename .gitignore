# Ignore everything by default
/*

# Track only these
!/GB_code/
!/GB_code_camera/
!/GB_code_permabot_labo/
!/GB_code_classic_method/
!/GB_Calibration/
!/GB_README_LINK.txt
!/.gitignore

# Within the tracked folders, exclude large/generated content that isn't "script":

# Local copies of trained model checkpoints -- already on the Hugging Face Hub,
# no need to duplicate multi-hundred-MB/GB weights in git. Matches e.g.
# act_ClickTargetPreprocess..., act__ClickTargetPreprocess... (double underscore),
# smolvla_ClickTargetPreprocess..., act_PermaBotLabo_v1, and git-cloned YOLO
# checkpoints like yolo_PermaBotLaboWeedDetection_pretest (wherever it's
# copied to -- this matches at any depth, not just top-level).
act_*/
smolvla_*/
yolo_*/

# Python bytecode cache
__pycache__/

# Screenshots, calibration frames, captured training photos -- none of this is script
*.png
*.jpg
*.jpeg

# Captured/labeled datasets (large, regenerable, not code) -- e.g.
# GB_code_permabot_labo/GB_YOLO_finetuning/data/raw_images/
data/

# Catch-all in case a stray model weight file ever ends up outside a named
# checkpoint dir above
*.safetensors
*.pt
*.pth
*.bin

# Zipped archives (e.g. GB_Calibration/Calibrations/frames.zip -- same calibration
# images already excluded above, just zipped)
*.zip

# Calibration output files (camera_*_to_robot.npy, camera_*_intrinsics.npy
# from GB_code_classic_method/GB01_so101_charuco_calibrate.py, etc.) --
# generated by running the scripts, not script themselves. Exception:
# GB_code/so101_calibration.npy and OLDso101_calibration.npy were already
# tracked before this rule and are kept tracked on purpose (see
# `git status`/.git history) -- this only stops *new* .npy files from being
# added going forward.
*.npy

# SO-101 URDF mesh files (GB_code_classic_method/assets/) -- fetched from the
# official TheRobotStudio/SO-ARM100 repo, not something we authored; the
# URDF itself (small, text) stays tracked since it's needed to reproduce FK.
*.stl

# Third-party tool cloned from GitHub (TemugeB/python_stereo_camera_calibrate),
# not code we wrote -- its own nested .git is also why git warned about an
# "embedded git repository" here
/GB_Calibration/Calibrations/python_stereo_camera_calibrate/
